<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- media tools name the app behind each media session (DeviceMediaMcpProvider) without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- The device's tools on the app server: an app that also depends on agent-app-server gets the plugin without
             listing it (PluginDiscovery). Nothing else reads this entry, so an app without the server never loads the
             class. -->
        <meta-data
            android:name="cc.noharry.agent.device.appserver.DeviceToolsPlugin"
            android:value="cc.noharry.agent.appserver.plugin" />
    </application>
</manifest>
