<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- launch_app resolves launcher activities by label or package without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".AndroidUseAccessibilityService"
            android:exported="true"
            android:label="@string/android_use_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/android_use_accessibility_service" />
        </service>
    </application>
</manifest>
